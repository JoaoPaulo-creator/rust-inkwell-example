fn twoSum(arr, target) {
    let left = 0;
    let right = arr.length() - 1;

    while (left < right) {
        let sum = arr[left] + arr[right];
        if (sum == target) {
            return [arr[left], arr[right]];
        } else {
            left = left + 1;
            right = right - 1;
        }
    }
    return [0, 0];
}

let arr = [1, 2, 3, 4, 5];
let result = twoSum(arr, 6);
print(result[0]);
print(result[1]);
